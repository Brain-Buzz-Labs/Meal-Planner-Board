{
  "buildCommand": "pnpm --filter @workspace/meal-planner run build && pnpm --filter @workspace/api-server run build:vercel",
  "outputDirectory": "artifacts/meal-planner/dist/public",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "includeFiles": "api/_handler.cjs"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
